  },
  "type": "module",
  "bin": {
    "shopify-chatgpt-ads-mcp": "src/cli.js"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.js",
