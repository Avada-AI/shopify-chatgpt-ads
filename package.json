{
  "name": "shopify-chatgpt-ads-mcp",
  "version": "0.2.1",
  "private": true,
  "description": "MCP server and agent skills to manage ChatGPT (OpenAI) ads for a Shopify store from your own AI agent. Campaigns start paused; spending and permanent changes are gated behind your yes.",
  "homepage": "https://github.com/Avada-AI/shopify-chatgpt-ads#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Avada-AI/shopify-chatgpt-ads.git"
  },
  "bugs": {
